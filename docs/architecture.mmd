  Reporter(["reporter"]) -.usa.-> ListScreen
  Technician(["technician"]) -.usa.-> DetailScreen
  Coordinator(["coordinator"]) -.usa.-> ListScreen

  Session["Sesion (previsto; no implementado en Semana 02)"]
  Persistence["Persistencia (previsto; no implementado en Semana 02)"]
  Location["Ubicacion/proveedores (previsto; no implementado en Semana 02)"]

