    ListScreen["Pantalla Lista"]
    DetailScreen["Pantalla Detalle"]
    HealthIndicator["Indicador de salud heredado (App.tsx)"]
  end

  subgraph APP["application"]
    ListUseCase["Caso de uso: listar incidencias"]
    GetUseCase["Caso de uso: obtener incidencia por id"]
